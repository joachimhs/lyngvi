<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>no.syntakserror.lyngvi</groupId>
  <artifactId>lyngvi-parent</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>lyngvi</name>
  <description>A hardened, agent-agnostic sandbox for autonomous coding agents.</description>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <modules>
    <module>lyngvi-gateway-api</module>
    <module>lyngvi-gateway</module>
    <module>lyngvi-gateway-plugins</module>
    <module>lyngvi-core</module>
    <module>lyngvi-cli</module>
    <module>lyngvi-gui</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <jackson.version>2.19.2</jackson.version>
    <picocli.version>4.7.7</picocli.version>
    <javafx.version>25.0.1</javafx.version>
    <junit.version>5.13.4</junit.version>
    <assertj.version>3.27.6</assertj.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-gateway-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-gateway-plugins</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-gateway</artifactId>
        <version>${project.version}</version>
        <classifier>all</classifier>
      </dependency>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-gateway-plugins</artifactId>
        <version>${project.version}</version>
        <classifier>confluence</classifier>
      </dependency>
      <dependency>
        <groupId>no.syntakserror.lyngvi</groupId>
        <artifactId>lyngvi-gateway-plugins</artifactId>
        <version>${project.version}</version>
        <classifier>jira</classifier>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <executions>
            <!-- Tests compile and run on the classpath so test doubles from other modules can be shared. -->
            <execution>
              <id>default-testCompile</id>
              <configuration>
                <useModulePath>false</useModulePath>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <useModulePath>false</useModulePath>
            <!-- The gateway harness sends explicit Host headers through java.net.http. -->
            <argLine>-Djdk.httpclient.allowRestrictedHeaders=host</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
