# lyngvi build arguments and local overrides.
# Copied to .env by 'setup.sh init'; existing values are never changed.

# Toolchain versions used when building the base image (see image/fragments/).
NODE_VERSION=22
JAVA_VERSION=21
PYTHON_VERSION=3.12

# Resource limits for the shared stack (proxy and gateway).
PROXY_MEM_LIMIT=512m
PROXY_CPU_LIMIT=1.0
GATEWAY_MEM_LIMIT=256m
GATEWAY_CPU_LIMIT=1.0
