# Build output
target/
/dist/
# The CLI runtime image or jar that init/upgrade place in a sandbox (never the lyngvi-cli source package)
/cli/

# Sandbox state (generated by init; never committed)
/state/
/.sessions/
# The skills of a sandbox belong to that sandbox; the ones Lyngvi ships live in templates/skills/
/skills/
/sandbox.config
/.env
/Containerfile
/docker-compose.yml
/AGENTS.md
/proxy/allowed-domains.txt
/proxy/gateway-hosts.txt
/gateway/secrets/*.env
/gateway/certs/*

# OS / IDE
.DS_Store
.idea/
*.iml
.vscode/
