<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>no.syntakserror.lyngvi</groupId>
    <artifactId>lyngvi-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>lyngvi-gui</artifactId>
  <name>lyngvi-gui</name>
  <description>JavaFX front-end: a thin shell over lyngvi-core.</description>

  <dependencies>
    <dependency>
      <groupId>no.syntakserror.lyngvi</groupId>
      <artifactId>lyngvi-core</artifactId>
    </dependency>
    <dependency>
      <groupId>no.syntakserror.lyngvi</groupId>
      <artifactId>lyngvi-gateway-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>no.syntakserror.lyngvi</groupId>
      <artifactId>lyngvi-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The changelog shown by the version button. -->
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes>
          <include>CHANGELOG.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>no.syntakserror.lyngvi.gui/no.syntakserror.lyngvi.gui.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -Pdist package: the jpackage app image (and a dmg on macOS, deb on Linux) in target/dist. -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>package-gui-app</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${project.basedir}/../packaging/package-gui.sh</executable>
                  <arguments><argument>${project.build.directory}/dist</argument><argument>app-image</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>package-gui-installer</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${project.basedir}/../packaging/package-gui-installer.sh</executable>
                  <arguments><argument>${project.build.directory}/dist</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- mvn -pl lyngvi-gui -Psmoke javafx:run: opens the window against $LYNGVI_HOME and closes after 16 seconds.
         The splash holds the first ten of those (Splash.MIN_VISIBLE), and the run has to outlast it: the first-run
         dialogs and the window's timers are what follows the splash, and a shorter run would never reach them. -->
    <profile>
      <id>smoke</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <configuration>
              <options>
                <option>-Dlyngvi.gui.smoke=16000</option>
              </options>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
