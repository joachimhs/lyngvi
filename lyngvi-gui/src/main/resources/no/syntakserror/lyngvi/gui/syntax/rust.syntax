name          = Rust
extensions    = rs
line.comment  = //
block.comment = /* */
string.quote  = "
char.quote    = '
escape        = \\
annotation    = #[ #![
keywords      = as async await break const continue crate dyn else enum extern fn for if impl in let loop match mod move mut pub ref return self static struct super trait type unsafe use where while
types         = bool char f32 f64 i8 i16 i32 i64 i128 isize str u8 u16 u32 u64 u128 usize String Vec Option Result Box Rc Arc HashMap
constants     = true false None Some Ok Err
