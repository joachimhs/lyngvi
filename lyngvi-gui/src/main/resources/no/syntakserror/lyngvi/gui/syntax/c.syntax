name          = C and C++
extensions    = c h cc cpp cxx hpp hh
line.comment  = //
block.comment = /* */
string.quote  = "
char.quote    = '
escape        = \\
annotation    = #
keywords      = alignas alignof auto break case catch class const constexpr continue decltype default delete do else enum explicit export extern for friend goto if inline mutable namespace new noexcept nullptr operator override private protected public register return sizeof static static_assert struct switch template this throw try typedef typeid typename union using virtual volatile while
types         = bool char double float int long short signed size_t ssize_t unsigned void wchar_t int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t string vector map
constants     = true false NULL
