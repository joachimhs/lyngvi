name          = JavaScript
extensions    = js mjs cjs jsx
line.comment  = //
block.comment = /* */
string.quote  = " ' `
escape        = \\
keywords      = as async await break case catch class const continue debugger default delete do else export extends finally for from function get if import in instanceof let new of return set static super switch this throw try typeof var void while with yield
types         = Array Boolean Date Error Function Map Number Object Promise RegExp Set String Symbol WeakMap
constants     = true false null undefined NaN Infinity
sample        = import { join } from "node:path";\n\n// the first file in a folder\nexport async function first(dir) {\n  const files = await readdir(dir);\n  return files.length > 0 ? join(dir, files[0]) : null;\n}
