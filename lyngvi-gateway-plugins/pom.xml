<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>no.syntakserror.lyngvi</groupId>
    <artifactId>lyngvi-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>lyngvi-gateway-plugins</artifactId>
  <name>lyngvi-gateway-plugins</name>
  <description>Reference gateway plugins (confluence, jira), packaged as separate jars.</description>

  <dependencies>
    <dependency>
      <groupId>no.syntakserror.lyngvi</groupId>
      <artifactId>lyngvi-gateway-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>no.syntakserror.lyngvi</groupId>
      <artifactId>lyngvi-gateway</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>no.syntakserror.lyngvi</groupId>
      <artifactId>lyngvi-gateway</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Each reference plugin ships as its own jar: the plugin's classes, the shared helpers and its service file. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-confluence</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/plugin-confluence</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.outputDirectory}</directory>
                  <includes>
                    <include>no/syntakserror/lyngvi/gateway/plugins/confluence/**</include>
                    <include>no/syntakserror/lyngvi/gateway/plugins/common/**</include>
                  </includes>
                </resource>
                <resource>
                  <directory>src/main/plugin-services/confluence</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>stage-jira</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/plugin-jira</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.outputDirectory}</directory>
                  <includes>
                    <include>no/syntakserror/lyngvi/gateway/plugins/jira/**</include>
                    <include>no/syntakserror/lyngvi/gateway/plugins/common/**</include>
                  </includes>
                </resource>
                <resource>
                  <directory>src/main/plugin-services/jira</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>confluence</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>confluence</classifier>
              <classesDirectory>${project.build.directory}/plugin-confluence</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>jira</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>jira</classifier>
              <classesDirectory>${project.build.directory}/plugin-jira</classesDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
